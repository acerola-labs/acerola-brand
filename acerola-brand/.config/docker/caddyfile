# The brand book's static site on port 3000 (project standard). HTTPS stays with the server's Caddy
# in front of it.
:3000 {
	root * /srv
	encode zstd gzip

	# Hashed file names never change: cache for a year.
	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# HTML, sitemaps, llms.txt and robots always revalidated, so a new deploy shows up right away.
	# Each locale lives under its prefix (/pt-br/…, /en/…) with its own sitemap.xml and llms.txt.
	@fresh path / /index.html /sitemap.xml /robots.txt /llms.txt /pt-br/* /en/*
	header @fresh Cache-Control "public, max-age=0, must-revalidate"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	try_files {path} {path}.html {path}/index.html
	file_server

	# Missing addresses get the prerendered 404.html (the SvelteKit fallback), with status 404.
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
